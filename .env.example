# Copy to .env (git-ignored) and fill in. Never commit .env.
# Values already set in your shell take precedence over this file.

# HubSpot live sync (test portals only). Create a service key with:
# crm.objects.contacts.read/write and crm.schemas.contacts.read/write
HUBSPOT_TOKEN=
HUBSPOT_ALLOWED_PORTALS=244742237

